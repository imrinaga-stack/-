# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Free Automatic Server Email (Gmail App Password or SMTP):
# When configured in AI Studio Secrets, every receipt is sent automatically in the background.
# Alternatively, connect Gmail directly in the app using "Sign in with Google".
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
